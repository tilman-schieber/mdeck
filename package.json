{
  "name": "@tilman.schieber/mdeck",
  "version": "1.3.2",
  "type": "module",
  "description": "Write slides as a plain text file, present them in the browser, share them as one HTML file or PDF.",
  "license": "MIT",
  "author": "Tilman Schieber",
  "homepage": "https://mdeck-996814.pages.fhnw.ch/",
  "repository": {
    "type": "git",
    "url": "https://gitlab.fhnw.ch/tilman.schieber/mdeck.git"
  },
  "bugs": {
    "url": "https://gitlab.fhnw.ch/tilman.schieber/mdeck/-/issues"
  },
  "keywords": [
    "markdown",
    "slides",
    "presentation",
    "deck",
    "pdf",
    "teaching"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mdeck": "./bin/mdeck.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "docs/README.md",
    "docs/reference",
    "docs/site",
    "!docs/site/dist",
    "examples",
    "skills",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "@tilman.schieber:registry": "https://gitlab.fhnw.ch/api/v4/projects/31311/packages/npm/"
  },
  "scripts": {
    "test": "node --test",
    "test:browser": "node tools/browser-check.mjs",
    "docs": "node bin/mdeck.js docs",
    "docs:build": "node docs/site/build.js",
    "dev": "node bin/mdeck.js dev",
    "present": "node bin/mdeck.js present",
    "edit": "node bin/mdeck.js edit",
    "build": "node bin/mdeck.js build",
    "preview": "node bin/mdeck.js preview",
    "playground": "vite --config playground/vite.config.js",
    "playground:build": "vite build --config playground/vite.config.js",
    "readme-images": "node tools/readme-images.mjs"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "preact": "^10.29.8",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.0",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
