{
  "name": "mdeck",
  "version": "3.17.1",
  "type": "module",
  "description": "Write slides as a plain text file, present them in the browser, share them as one HTML file or PDF.",
  "license": "MIT",
  "author": "Tilman Schieber",
  "homepage": "https://gh.tschieber.de/mdeck/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tilman-schieber/mdeck.git"
  },
  "bugs": {
    "url": "https://github.com/tilman-schieber/mdeck/issues"
  },
  "keywords": [
    "markdown",
    "slides",
    "presentation",
    "deck",
    "pdf",
    "teaching"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mdeck": "./bin/mdeck.js"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "docs/README.md",
    "docs/reference",
    "docs/site",
    "!docs/site/dist",
    "examples",
    "skills",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --import ./tests/isolate-home.js",
    "test:browser": "node tools/browser-check.mjs",
    "test:server": "node tools/server-check.mjs",
    "test:docs": "node tools/docs-check.mjs",
    "test:themes": "node tools/theme-check.mjs",
    "docs": "node bin/mdeck.js docs",
    "docs:build": "node docs/site/build.js",
    "start": "node bin/mdeck.js run",
    "edit": "node bin/mdeck.js edit",
    "build": "node bin/mdeck.js build",
    "preview": "node bin/mdeck.js preview",
    "playground": "vite --config playground/vite.config.js",
    "playground:build": "vite build --config playground/vite.config.js",
    "readme-images": "node tools/readme-images.mjs",
    "theme-images": "node tools/theme-images.mjs",
    "feature-images": "node tools/feature-images.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@preact/preset-vite": "^2.10.6",
    "citeproc": "^2.4.63",
    "d3-cloud": "^1.2.9",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "perfect-freehand": "^1.2.3",
    "preact": "^10.29.8",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.0",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  }
}
